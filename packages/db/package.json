{
    "name": "@hilda/db",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json --watch",
        "lint": "tsc -p tsconfig.json --noEmit",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "echo db-ok",
        "clean": "rm -rf dist",
        "db:migrate": "sequelize-cli db:migrate",
        "db:migrate:undo": "sequelize-cli db:migrate:undo",
        "db:create": "sequelize-cli db:create"
    },
    "dependencies": {
        "@hilda/shared": "workspace:*",
        "pg": "^8.13.1",
        "sequelize": "^6.37.5"
    },
    "devDependencies": {
        "@types/node": "^22.7.4",
        "sequelize-cli": "^6.6.2",
        "tsx": "^4.19.1"
    }
}